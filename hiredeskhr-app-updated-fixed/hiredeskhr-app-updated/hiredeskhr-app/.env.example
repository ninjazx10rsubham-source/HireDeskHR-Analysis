# ==============================================================================
# HiredeskHR - Production Environment Configuration Template (.env)
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5001
JWT_SECRET=production_jwt_super_secure_secret_key_change_me_ats_30

# Elastic Email REST API (Primary Outbound Email & OTP Dispatch)
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here

# Recruiter Alert Configuration (Real notifications dispatched on inbound candidate apply)
RECRUITER_NOTIFICATION_EMAIL=shravanihn20@gmail.com
FROM_EMAIL=recruiter@hiredeskhr.com
FROM_NAME=HiredeskHR

# Hostinger Business Email / Custom SMTP Gateway (Secondary Outbound Fallback)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sonukumar@medicoworkforce.com
SMTP_PASS=your_hostinger_email_password_here

# Hostinger IMAP Inbound Mailbox Gateway (Monitors inbound applicant emails)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=sonukumar@medicoworkforce.com
IMAP_PASS=your_hostinger_email_password_here

# WhatsApp Cloud API (Meta Official Cloud / UltraMsg Gateway)
WHATSAPP_API_TOKEN=your_meta_cloud_or_ultramsg_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_INSTANCE_ID=instance_id_if_using_ultramsg

# Google Calendar & Google Meet Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/calendar/oauth2callback

# AI Video & Screening Interview Engine (Google Gemini / LLM)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Contabo VPS & Domain Configuration
PUBLIC_APP_URL=https://yourdomain.com
API_BASE_URL=https://yourdomain.com/api
