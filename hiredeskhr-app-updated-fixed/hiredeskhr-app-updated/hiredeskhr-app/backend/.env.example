# =============================================================================
# HiredeskHR - Backend configuration
# =============================================================================
# Copy this file to backend/.env and fill in the values, or just run:
#     npm run setup:otp
# Check your setup at any time with:
#     npm run verify:otp
# =============================================================================

PORT=5001
NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. EMAIL OTP - Gmail SMTP (primary)
# -----------------------------------------------------------------------------
# The OTP email is sent FROM this account TO whatever address each user types
# into the signup/login form. The recipient is always dynamic.
#
# SMTP_PASS must be a Gmail *App Password*, not your normal Gmail password:
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an App Password:       https://myaccount.google.com/apppasswords
#   3. Paste the 16-character value below (spaces are stripped automatically)
#
# If port 465 is blocked on your network, set SMTP_PORT=587. The backend also
# retries the other port automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=HiredeskHR

# -----------------------------------------------------------------------------
# 2. EMAIL OTP - Elastic Email REST API (fallback)
# -----------------------------------------------------------------------------
# Used automatically if SMTP is not configured, or if SMTP fails at send time.
# Works over plain HTTPS, so it is a good option where SMTP ports are blocked.
ELASTIC_EMAIL_API_KEY=

# Internal alert address for new candidate applications (optional).
RECRUITER_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# 3. WHATSAPP OTP - Meta WhatsApp Cloud API (primary)
# -----------------------------------------------------------------------------
# From https://developers.facebook.com -> your app -> WhatsApp -> API Setup:
#   WHATSAPP_PHONE_ID    the long numeric "Phone number ID" (NOT the phone number)
#   WHATSAPP_API_TOKEN   an access token. The temporary one in the dashboard
#                        expires after 24 hours - create a permanent System User
#                        token with the whatsapp_business_messaging permission.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# READ THIS - it is the #1 reason WhatsApp OTPs silently fail:
# Meta will not deliver a plain text message to someone who has not messaged
# your business in the last 24 hours. For signup OTPs, that is every new user.
# To reach them you need an approved AUTHENTICATION template:
#   WhatsApp Manager -> Message Templates -> Create -> Authentication
# Then set its exact name and language code here.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# Graph API version used for Cloud API calls.
WHATSAPP_GRAPH_VERSION=v21.0

# While your Meta app is in development mode, Meta only delivers to numbers you
# have added under WhatsApp -> API Setup -> "To". Add your test number there.

# -----------------------------------------------------------------------------
# 4. WHATSAPP OTP - UltraMsg (fallback, easier to start with)
# -----------------------------------------------------------------------------
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# -----------------------------------------------------------------------------
# 5. Phone number handling
# -----------------------------------------------------------------------------
# Applied when a user types a bare national number, e.g. 8217877923 or
# 08217877923 both become 918217877923.
DEFAULT_COUNTRY_CODE=91

# -----------------------------------------------------------------------------
# 6. Local development convenience
# -----------------------------------------------------------------------------
# When NO email and NO WhatsApp provider is configured, the API returns the
# generated code as "devOtp" so you can still complete signup while building.
# This is automatically OFF when NODE_ENV=production or once any provider is
# configured. Set to true to disable it even in development.
DISABLE_DEV_OTP_FALLBACK=false
